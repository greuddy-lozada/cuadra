# Backend Configuration
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL local via Podman)
DATABASE_URL="postgresql://cuadra:cuadra_dev@localhost:5432/cuadra_dev"
DATABASE_CONNECTION_LIMIT=5
# For SQLite (alternative):
# DATABASE_URL="file:./dev.db"

# Redis (optional in dev — falls back to in-memory cache)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# Pago Móvil (System account for subscription payments)
PAGO_MOVIL_PHONE=
PAGO_MOVIL_BANK=
PAGO_MOVIL_ID_NUMBER=

# Email (optional in dev — invites still create + copy link)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@cuadra.app

# Ask AI (optional). Leave the key or URL empty to hide the assistant.
# DeepSeek: ASSISTANT_BASE_URL=https://api.deepseek.com  ASSISTANT_MODEL=deepseek-chat
# Moonshot:  ASSISTANT_BASE_URL=https://api.moonshot.ai/v1  ASSISTANT_MODEL=moonshot-v1-8k
ASSISTANT_PROVIDER=openai-compatible
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=40
