// Prisma schema for Cuadra
// Multi-currency enabled — all financial transactions store
// VED (Bolívares) + USD amounts + exchange rate at time of record

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────
// ROLE
// ────────────────────────────────────────────
model Role {
  id        String   @id @default(uuid()) @db.Uuid @map("id")
  name      String   @map("name")
  slug      String   @unique @map("slug")
  type      String   @default("org") @map("type")
  level     Int      @default(0) @map("level")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  userOrganizations  UserOrganization[]
  invites            Invite[]

  @@map("roles")
}

// ────────────────────────────────────────────
// USER
// ────────────────────────────────────────────
model User {
  id                 String    @id @default(uuid()) @db.Uuid @map("id")
  email              String    @unique @map("email")
  userName           String    @unique @map("user_name")
  password           String    @map("password")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  idRole             String    @db.Uuid @map("id_role")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLogin          DateTime? @map("last_login")
  isActive           Boolean   @default(true) @map("is_active")
  version            Int       @default(0) @map("version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  currentOrganizationId  String? @db.Uuid @map("current_organization_id")

  role                   Role                      @relation(fields: [idRole], references: [id])
  refreshTokens          RefreshToken[]
  currentOrganization    Organization?             @relation("CurrentOrg", fields: [currentOrganizationId], references: [id])
  organizations          UserOrganization[]
  invites                Invite[]                  @relation("InvitedBy")
  pagoMovilTransactions     PagoMovilTransaction[]
  reviewedSubscriptionPayments SubscriptionPayment[]  @relation("Reviewer")
  generatedReports      GeneratedReport[]
  assistantThreads      AssistantThread[]
  registerSessions      RegisterSession[]
  closedSettlements     RegisterSettlement[] @relation("SettlementClosedBy")
  adminApprovalsPerformed AdminApproval[] @relation("AdminApprovalPerformedBy")
  adminApprovalsApproved  AdminApproval[] @relation("AdminApprovalApprovedBy")

  @@map("users")
  @@index([idRole])
  @@index([currentOrganizationId])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// REFRESH TOKEN
// ────────────────────────────────────────────
model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid @map("id")
  tokenId    String   @unique @map("token_id")
  tokenHash  String   @map("token_hash")
  userId     String   @db.Uuid @map("user_id")
  deviceInfo String?  @map("device_info")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
  @@index([userId])
  @@index([expiresAt])
}

// ────────────────────────────────────────────
// PERMISSION
// ────────────────────────────────────────────
model Permission {
  id        String      @id @default(uuid()) @db.Uuid @map("id")
  name      String?  @map("name")
  slug      String?  @map("slug")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

// ────────────────────────────────────────────
// ORGANIZATION (Multi-tenant core)
// ────────────────────────────────────────────
model Organization {
  id        String       @id @default(uuid()) @db.Uuid @map("id")
  name      String    @map("name")
  slug      String    @unique @map("slug")
  version   Int       @default(0) @map("version")
  isActive  Boolean   @default(true) @map("is_active")
  settings  String?   @map("settings")
  planId                String? @db.Uuid @map("plan_id")
  subscriptionStatus    String     @default("inactive") @map("subscription_status")
  subscriptionExpiresAt DateTime?  @map("subscription_expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  plan                  Plan?                    @relation(fields: [planId], references: [id])
  users                 User[]                   @relation("CurrentOrg")
  userMemberships       UserOrganization[]
  suppliers             Supplier[]
  customers             Customer[]
  companies             Company[]
  brands                Brand[]
  categories            Category[]
  products              Product[]
  taxes                 Tax[]
  batches               Batch[]
  stocks                Stock[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderDets     PurchaseOrderDet[]
  sales                 Sale[]
  salesDets             SalesDet[]
  exchangeRates         ExchangeRate[]
  exchangeRateDays      ExchangeRateDay[]
  withholdingRecords    WithholdingRecord[]
  accountsPayable       AccountsPayable[]
  accountsReceivable    AccountsReceivable[]
  invites               Invite[]
  pagoMovilConfigs      PagoMovilConfig[]
  pagoMovilTransactions PagoMovilTransaction[]
  syncCursors           SyncCursor[]
  syncConflicts         SyncConflict[]
  salePayments          SalePayment[]
  auditLogs             AuditLog[]
  subscriptionPayments  SubscriptionPayment[]
  generatedReports      GeneratedReport[]
  assistantThreads      AssistantThread[]
  cashRegisters          CashRegister[]
  registerSessions       RegisterSession[]
  registerSettlements    RegisterSettlement[]

  @@map("organizations")
  @@index([planId])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// PLAN
// ────────────────────────────────────────────
model Plan {
  id        String      @id @default(uuid()) @db.Uuid @map("id")
  name      String   @unique @map("name")
  label     String   @map("label")
  amount    Decimal  @db.Decimal(18,4) @map("amount")
  currency  String   @default("usd") @map("currency")
  interval  String   @map("interval")
  features  String   @map("features")
  maxUsers  Int      @default(5) @map("max_users")
  version        Int       @default(0) @map("version")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organizations        Organization[]
  subscriptionPayments SubscriptionPayment[]

  @@map("plans")
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// SUBSCRIPTION PAYMENT
// ────────────────────────────────────────────
model SubscriptionPayment {
  id                String       @id @default(uuid()) @db.Uuid @map("id")
  organizationId    String @db.Uuid @map("organization_id")
  planId            String @db.Uuid @map("plan_id")
  method            String    @map("method")
  amountUsd         Decimal   @db.Decimal(18,4) @map("amount_usd")
  status            String    @default("pending") @map("status")

  bankId            String?   @map("bank_id")
  phoneNumber       String?   @map("phone_number")
  reference         String?   @map("reference")
  proofImage        String?   @map("proof_image")

  reviewedBy        String?  @db.Uuid @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at")
  notes             String?   @map("notes")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])
  reviewer     User?        @relation("Reviewer", fields: [reviewedBy], references: [id])

  @@map("subscription_payments")
  @@index([organizationId])
  @@index([planId])
  @@index([reviewedBy])
  @@index([status])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// USER ORGANIZATION (M:N pivot)
// ────────────────────────────────────────────
model UserOrganization {
  userId         String @db.Uuid @map("user_id")
  organizationId String @db.Uuid @map("organization_id")
  roleId         String @db.Uuid @map("role_id")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@id([userId, organizationId])
  @@map("user_organizations")
  @@index([organizationId])
  @@index([roleId])
}

// ────────────────────────────────────────────
// INVITE
// ────────────────────────────────────────────
model Invite {
  id             String      @id @default(uuid()) @db.Uuid @map("id")
  code           String   @unique @map("code")
  email          String   @map("email")
  organizationId String @db.Uuid @map("organization_id")
  roleId         String @db.Uuid @map("role_id")
  invitedById    String @db.Uuid @map("invited_by_id")
  expiresAt      DateTime @map("expires_at")
  version        Int      @default(0) @map("version")
  used           Boolean  @default(false) @map("used")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@map("invites")
  @@index([organizationId])
  @@index([roleId])
  @@index([invitedById])
  @@index([email])
  @@index([expiresAt])
}

// ────────────────────────────────────────────
// PAGO MOVIL CONFIG
// ────────────────────────────────────────────
model PagoMovilConfig {
  id             String      @id @default(uuid()) @db.Uuid @map("id")
  organizationId String @db.Uuid @unique @map("organization_id")
  phoneNumber    String   @map("phone_number")
  bankId         String   @map("bank_id")
  idNumber       String   @map("id_number")
  exchangeRate   Float    @map("exchange_rate")
  version        Int      @default(0) @map("version")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization    Organization @relation(fields: [organizationId], references: [id])

  @@map("pago_movil_configs")
  @@index([organizationId])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// PAGO MOVIL TRANSACTION
// ────────────────────────────────────────────
model PagoMovilTransaction {
  id             String       @id @default(uuid()) @db.Uuid @map("id")
  organizationId String @db.Uuid @map("organization_id")
  userId         String @db.Uuid @map("user_id")
  amountVes      Decimal   @db.Decimal(18,4) @map("amount_ves")
  amountUsd      Decimal   @db.Decimal(18,4) @map("amount_usd")
  bankId         String    @map("bank_id")
  phoneNumber    String    @map("phone_number")
  reference      String    @map("reference")
  proofImage     String?   @map("proof_image")
  version        Int       @default(0) @map("version")
  status         String    @default("pending") @map("status")
  reviewedBy     String?   @db.Uuid @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("pago_movil_transactions")
  @@index([userId])
  @@index([reviewedBy])
  @@index([status])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// CUSTOMER
// ────────────────────────────────────────────
model Customer {
  id                   String       @id @default(uuid()) @db.Uuid @map("id")
  idCardNumber         String    @map("id_card_number")
  firstName            String    @map("first_name")
  lastName             String    @map("last_name")
  address              String?   @map("address")
  phoneNumber          String?   @map("phone_number")
  email                String?   @map("email")
  version              Int       @default(0) @map("version")
  available            Boolean   @default(true) @map("available")
  isWithholdingAgent   Boolean   @default(false) @map("is_withholding_agent")
  withholdingPercentage Float?   @map("withholding_percentage")
  withholdingProof     String?   @map("withholding_proof")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")
  organizationId       String @db.Uuid @map("organization_id")

  organization Organization @relation(fields: [organizationId], references: [id])
  sales        Sale[]

  @@map("customers")
  @@index([organizationId])
  @@index([organizationId, available])
  @@index([organizationId, updatedAt])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// SUPPLIER
// ────────────────────────────────────────────
model Supplier {
  id                 String       @id @default(uuid()) @db.Uuid @map("id")
  companyName        String    @map("company_name")
  businessName       String?   @map("business_name")
  fiscalAddress      String?   @map("fiscal_address")
  taxId              String?   @map("tax_id")
  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  address            String?   @map("address")
  phoneNumber        String?   @map("phone_number")
  email              String?   @map("email")
  taxWithholdingAgent Boolean  @default(false) @map("tax_withholding_agent")
  version            Int       @default(0) @map("version")
  available          Boolean   @default(true) @map("available")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  organizationId     String @db.Uuid @map("organization_id")

  organization      Organization          @relation(fields: [organizationId], references: [id])
  stocks            Stock[]
  purchaseOrders    PurchaseOrder[]
  withholdingRecords WithholdingRecord[]

  @@map("suppliers")
  @@index([organizationId])
  @@index([organizationId, available])
  @@index([organizationId, updatedAt])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// COMPANY
// ────────────────────────────────────────────
model Company {
  id                    String       @id @default(uuid()) @db.Uuid @map("id")
  taxId                 String    @default("") @map("tax_id")
  name                  String    @map("name")
  address               String    @map("address")
  phoneNumber           String    @map("phone_number")
  email                 String    @map("email")
  website               String?   @map("website")
  isWithholdingAgent    Boolean   @default(false) @map("is_withholding_agent")
  withholdingPercentage Float?    @map("withholding_percentage")
  version               Int       @default(0) @map("version")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  organizationId        String @db.Uuid @map("organization_id")

  organization Organization @relation(fields: [organizationId], references: [id])
  licenses     License[]

  @@map("companies")
  @@index([organizationId])
  @@index([organizationId, updatedAt])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// LICENSE
// ────────────────────────────────────────────
model License {
  id         String       @id @default(uuid()) @db.Uuid @map("id")
  code       String?   @map("code")
  idCompany  String @db.Uuid @map("id_company")
  version    Int       @default(0) @map("version")
  available  Boolean?  @map("available")
  expiryDate DateTime? @map("expiry_date")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [idCompany], references: [id])

  @@map("licenses")
  @@index([idCompany])
}

// ────────────────────────────────────────────
// CURRENCY
// ────────────────────────────────────────────
model Currency {
  id        String      @id @default(uuid()) @db.Uuid @map("id")
  code      String?  @map("code")
  name      String?  @map("name")
  symbol    String?  @map("symbol")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exchangeRates ExchangeRate[]

  @@map("currencies")
}

// ────────────────────────────────────────────
// EXCHANGE RATE
// ────────────────────────────────────────────
model ExchangeRate {
  id             String      @id @default(uuid()) @db.Uuid @map("id")
  rate           Float    @map("rate")
  currencyId     String? @db.Uuid @map("currency_id")
  type           String   @default("official") @map("type")
  date           DateTime @map("date")
  source         String?  @map("source")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  organizationId String @db.Uuid @map("organization_id")

  organization          Organization             @relation(fields: [organizationId], references: [id])
  currency              Currency?                @relation(fields: [currencyId], references: [id])
  purchaseOrders        PurchaseOrder[]          @relation("CalculationRate")
  officialPurchaseOrders PurchaseOrder[]         @relation("OfficialRate")
  sales                 Sale[]                   @relation("CalculationRate")
  officialSales         Sale[]                   @relation("OfficialRate")
  productLinks          ProductsExchangeRates[]

  @@map("exchange_rates")
  @@index([organizationId])
  @@index([currencyId])
  @@index([date])
  @@index([organizationId, updatedAt])
}

// ────────────────────────────────────────────
// EXCHANGE RATE DAY
// ────────────────────────────────────────────
model ExchangeRateDay {
  id              String      @id @default(uuid()) @db.Uuid @map("id")
  date            DateTime @map("date")
  rateBcvUsd      Float?   @map("rate_bcv_usd")
  rateParalelo    Float?   @map("rate_paralelo")
  source          String?  @default("dolarapi") @map("source")
  organizationId  String @db.Uuid @map("organization_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, date])
  @@map("exchange_rate_days")
  @@index([organizationId])
}

// ────────────────────────────────────────────
// MODULE
// ────────────────────────────────────────────
model Module {
  id        String      @id @default(uuid()) @db.Uuid @map("id")
  name      String?  @map("name")
  available Boolean? @map("available")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("modules")
}

// ────────────────────────────────────────────
// TAX
// ────────────────────────────────────────────
model Tax {
  id             String       @id @default(uuid()) @db.Uuid @map("id")
  name           String?   @map("name")
  percentage     Int       @map("percentage")
  formula        String?   @map("formula")
  version        Int       @default(0) @map("version")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@map("taxes")
  @@index([organizationId])
  @@index([organizationId, updatedAt])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// BRAND
// ────────────────────────────────────────────
model Brand {
  id             String       @id @default(uuid()) @db.Uuid @map("id")
  name           String    @map("name")
  description    String?   @map("description")
  version        Int       @default(0) @map("version")
  available      Boolean   @default(true) @map("available")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@map("brands")
  @@index([organizationId])
  @@index([organizationId, available])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// CATEGORY
// ────────────────────────────────────────────
model Category {
  id             String        @id @default(uuid()) @db.Uuid @map("id")
  name           String     @map("name")
  description    String?    @map("description")
  idParent       String? @db.Uuid @map("id_parent")
  parent         Category?  @relation("CategoryHierarchy", fields: [idParent], references: [id])
  children       Category[] @relation("CategoryHierarchy")
  version        Int        @default(0) @map("version")
  available      Boolean    @default(true) @map("available")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@map("categories")
  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([organizationId, available])
  @@index([idParent])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// PRODUCT
// ────────────────────────────────────────────
model Product {
  id              String          @id @default(uuid()) @db.Uuid @map("id")
  code            String       @map("code")
  name            String       @map("name")
  price           Decimal      @db.Decimal(18,4) @map("price")
  dollarPrice     Decimal?     @db.Decimal(18,4) @map("dollar_price")
  baseCost        Decimal?     @db.Decimal(18,4) @map("base_cost")
  margin          Float        @default(20) @map("margin")
  totalExistence  Int          @default(0) @map("total_existence")
  idTax           String? @db.Uuid @map("id_tax")
  idBrand         String? @db.Uuid @map("id_brand")
  idCategory      String? @db.Uuid @map("id_category")
  observation     String?      @map("observation")
  version         Int          @default(0) @map("version")
  available       Boolean      @default(true) @map("available")
  image           String?      @map("image")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  organizationId  String @db.Uuid @map("organization_id")

  organization             Organization               @relation(fields: [organizationId], references: [id])
  tax                      Tax?                       @relation(fields: [idTax], references: [id])
  brand                    Brand?                     @relation(fields: [idBrand], references: [id])
  category                 Category?                  @relation(fields: [idCategory], references: [id])
  stocks                   Stock[]
  purchaseOrderDetails     PurchaseOrderDet[]
  saleDetails              SalesDet[]
  exchangeRateLinks        ProductsExchangeRates[]

  @@map("products")
  @@index([organizationId])
  @@index([organizationId, available])
  @@index([organizationId, updatedAt])
  @@index([idTax])
  @@index([idBrand])
  @@index([idCategory])
  @@index([code])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// BATCH
// ────────────────────────────────────────────
model Batch {
  id             String       @id @default(uuid()) @db.Uuid @map("id")
  code           String    @map("code")
  description    String?   @map("description")
  version        Int       @default(0) @map("version")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")

  organization Organization @relation(fields: [organizationId], references: [id])
  stocks       Stock[]

  @@map("batches")
  @@index([organizationId])
  @@index([code])
  @@index([deletedAt])
}

// ────────────────────────────────────────────
// STOCK
// ────────────────────────────────────────────
model Stock {
  id              String       @id @default(uuid()) @db.Uuid @map("id")
  idProduct       String @db.Uuid @map("id_product")
  idSupplier      String? @db.Uuid @map("id_supplier")
  idBatch         String? @db.Uuid @map("id_batch")
  idPurchaseOrder String? @db.Uuid @map("id_purchase_order")
  existence       Int       @map("existence")
  version         Int       @default(0) @map("version")
  available       Boolean   @default(true) @map("available")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  organizationId  String @db.Uuid @map("organization_id")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  product       Product       @relation(fields: [idProduct], references: [id])
  supplier      Supplier?     @relation(fields: [idSupplier], references: [id])
  batch         Batch?        @relation(fields: [idBatch], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [idPurchaseOrder], references: [id])
  stockDets     StockDet[]

  @@map("stocks")
  @@index([organizationId])
  @@index([organizationId, available])
  @@index([idProduct])
  @@index([idProduct, organizationId])
  @@index([idSupplier])
  @@index([idBatch])
  @@index([idPurchaseOrder])
  @@index([deletedAt])
}

