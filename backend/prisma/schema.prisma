// ────────────────────────────────────────────
// CASH REGISTER
// ────────────────────────────────────────────

enum RegisterSessionStatus {
  abierta
  cerrada
}

model CashRegister {
  id             String   @id @default(uuid()) @db.Uuid @map("id")
  organizationId String   @db.Uuid @map("organization_id")
  name           String   @map("name")
  code           String   @map("code")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  sessions       RegisterSession[]

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@map("cajas")
  @@index([organizationId])
}

model RegisterSession {
  id              String               @id @default(uuid()) @db.Uuid @map("id")
  cashRegisterId  String               @db.Uuid @map("caja_id")
  userId          String               @db.Uuid @map("user_id")
  organizationId  String               @db.Uuid @map("organization_id")
  initialCash     Decimal              @default(0) @db.Decimal(18,4) @map("initial_cash")
  initialCashUsd  Decimal              @default(0) @db.Decimal(18,4) @map("initial_cash_usd")
  status          RegisterSessionStatus @default(abierta) @map("status")
  openedAt        DateTime             @default(now()) @map("opened_at")
  closedAt        DateTime?            @map("closed_at")
  notes           String?              @map("notes")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  cashRegister    CashRegister         @relation(fields: [cashRegisterId], references: [id])
  user            User                 @relation(fields: [userId], references: [id])
  organization    Organization         @relation(fields: [organizationId], references: [id])
  sales           Sale[]
  settlements     RegisterSettlement[]

  @@map("caja_aperturas")
  @@index([cashRegisterId])
  @@index([userId])
  @@index([organizationId, status])
  @@index([userId, status])
}

model RegisterSettlement {
  id              String          @id @default(uuid()) @db.Uuid @map("id")
  sessionId       String          @db.Uuid @map("caja_apertura_id")
  organizationId  String          @db.Uuid @map("organization_id")
  expectedCash    Decimal         @db.Decimal(18,4) @map("expected_cash")
  countedCash     Decimal         @db.Decimal(18,4) @map("counted_cash")
  difference      Decimal         @db.Decimal(18,4) @map("difference")
  closedById      String          @db.Uuid @map("closed_by_id")
  notes           String?         @map("notes")
  closedAt        DateTime        @default(now()) @map("closed_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  session         RegisterSession @relation(fields: [sessionId], references: [id])
  closedBy        User            @relation("SettlementClosedBy", fields: [closedById], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id])

  @@map("corte_cajas")
  @@index([sessionId])
  @@index([organizationId])
}

// ────────────────────────────────────────────
// ADMIN APPROVAL
// ────────────────────────────────────────────
model AdminApproval {
  id              String   @id @default(uuid()) @db.Uuid @map("id")
  action          String   @map("action")
  entity          String   @map("entity")
  entityId        String   @map("entity_id") @db.Uuid
  description     String   @map("description") @db.Text
  performedById   String   @map("performed_by_id") @db.Uuid
  performedAt     DateTime @default(now()) @map("performed_at") @db.Timestamptz()
  approvedById    String?  @map("approved_by_id") @db.Uuid
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz()
  status          String   @default("pending") @map("status")
  metadata        Json     @default("{}") @db.JsonB
  rejectionReason String?  @map("rejection_reason") @db.Text

  performedBy User  @relation("AdminApprovalPerformedBy", fields: [performedById], references: [id])
  approvedBy  User? @relation("AdminApprovalApprovedBy", fields: [approvedById], references: [id])

  @@map("admin_approvals")
  @@index([status])
  @@index([performedById])
  @@index([status, performedAt])
}
