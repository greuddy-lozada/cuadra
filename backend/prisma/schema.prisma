// ────────────────────────────────────────────
// SALE
// ────────────────────────────────────────────
model Sale {
  id                     String        @id @default(uuid()) @db.Uuid @map("id")
  idCustomer             String? @db.Uuid @map("id_customer")
  code                   String?    @map("code")
  date                   DateTime?  @map("date")
  amount                 Decimal?   @db.Decimal(18,4) @map("amount")
  amountUsd              Decimal?   @db.Decimal(18,4) @map("amount_usd")
  exchangeRate           Float?     @map("exchange_rate")
  exchangeRateId         String? @db.Uuid @map("exchange_rate_id")
  officialExchangeRate   Float?     @map("official_exchange_rate")
  officialExchangeRateId String? @db.Uuid @map("official_exchange_rate_id")
  totalTax               Decimal?   @db.Decimal(18,4) @map("total_tax")
  totalTaxUsd            Decimal?   @db.Decimal(18,4) @map("total_tax_usd")
  withholdingPercentage  Float?     @map("withholding_percentage")
  withholdingAmount      Decimal?   @db.Decimal(18,4) @map("withholding_amount")
  withholdingAmountUsd   Decimal?   @db.Decimal(18,4) @map("withholding_amount_usd")
  paymentMethod          Int?       @map("payment_method")
  status                 String?   @default("DRAFT")
  version                Int        @default(0) @map("version")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")
  deletedAt              DateTime?  @map("deleted_at")
  annulledAt             DateTime?  @map("annulled_at")
  annulmentReason        String?    @map("annulment_reason")
  organizationId         String @db.Uuid @map("organization_id")
  registerSessionId     String? @db.Uuid @map("caja_apertura_id")

  organization               Organization        @relation(fields: [organizationId], references: [id])
  customer                   Customer?           @relation(fields: [idCustomer], references: [id])
  details                    SalesDet[]
  payments                   SalePayment[]
  accountsReceivables        AccountsReceivable[]
  exchangeRateRef            ExchangeRate?       @relation("CalculationRate", fields: [exchangeRateId], references: [id])
  officialExchangeRateRef    ExchangeRate?       @relation("OfficialRate", fields: [officialExchangeRateId], references: [id])
  registerSession            RegisterSession?    @relation(fields: [registerSessionId], references: [id])

  @@map("sales")
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, date])
  @@index([idCustomer])
  @@index([exchangeRateId])
  @@index([officialExchangeRateId])
  @@index([status])
  @@index([date])
  @@index([code])
  @@index([deletedAt])
  @@index([registerSessionId])
}

