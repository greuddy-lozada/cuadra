# Copy to .env.production on the server and fill in real values.
# Never commit .env.production.

# ── PostgreSQL (used by docker-compose.prod.yml) ──
POSTGRES_USER=cuadra
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=cuadra

# ── Backend ──
JWT_SECRET=change-me-to-a-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Public URL testers use (no trailing slash).
# LAN HTTPS (self-signed): https://YOUR_IP:8443
# HTTP fallback still on :8081, but use HTTPS for PIN / service workers.
FRONTEND_URL=https://YOUR_IP:8443

# Optional: force TLS IP for scripts/generate-lan-tls.sh if FRONTEND_URL has no IP
# TLS_IP=192.168.1.150

# Optional overrides (compose sets DATABASE_URL / REDIS_URL / PORT automatically)
# PORT=4000
# LOG_LEVEL=info

# Seed policy (scripts/deploy.sh):
#   Default: seed only if organization count is 0
#   SKIP_SEED=1   — never seed
#   FORCE_SEED=1  — always run seed.ts (still no-ops if orgs exist inside seed)
# SKIP_SEED=0
# FORCE_SEED=0

# Ask AI (optional). No default host. Empty key or URL keeps the feature off.
# DeepSeek: ASSISTANT_BASE_URL=https://api.deepseek.com
# Moonshot: ASSISTANT_BASE_URL=https://api.moonshot.ai/v1
ASSISTANT_PROVIDER=openai-compatible
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=40
