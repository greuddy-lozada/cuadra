      "pagoMovil": {
        "q": "Does it include Pago Móvil?",
        "a": "On Professional you can record Pago Móvil charges in the sale flow. Receipt verification evolves with the product."
      },
      "devices": {
        "q": "Do I need to install an app?",
        "a": "No. Cuadra is a PWA: it runs in the browser on phone, tablet, or PC — no app store."
      },
      "sync": {
        "q": "What if sync conflicts happen?",
        "a": "The sync engine detects conflicts and surfaces them for resolution. Your local data is not lost."
      },
      "support": {
